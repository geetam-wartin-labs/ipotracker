{
  "version": 2,
  "builds": [{ "src": "api/index.js", "use": "@vercel/node" }],
  "routes": [{ "src": "/api/(.*)", "dest": "api/index.js" }],
  "crons": [
    { "path": "/api/cron/subscriptions?token=a3f9c1e8b2d4567890abcdef1234567890fedcba0987654321abcdef0123456", "schedule": "30 4 * * *" },
    { "path": "/api/cron/subscriptions?token=a3f9c1e8b2d4567890abcdef1234567890fedcba0987654321abcdef0123456", "schedule": "*/30 5-12 * * *" },
    { "path": "/api/cron/grey-market?token=a3f9c1e8b2d4567890abcdef1234567890fedcba0987654321abcdef0123456", "schedule": "0 */2 * * *" },
    { "path": "/api/cron/new-issues?token=a3f9c1e8b2d4567890abcdef1234567890fedcba0987654321abcdef0123456", "schedule": "30 2,14 * * *" },
    { "path": "/api/cron/issue-details?token=a3f9c1e8b2d4567890abcdef1234567890fedcba0987654321abcdef0123456", "schedule": "30 2 * * *" },
    { "path": "/api/cron/listing?token=a3f9c1e8b2d4567890abcdef1234567890fedcba0987654321abcdef0123456", "schedule": "30 12 * * *" }
  ]
}
